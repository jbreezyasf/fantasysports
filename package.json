{
  "name": "fantasy-all-sports",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.5.1",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "test:a11y": "npm run test:a11y --workspace @fantasy-all-sports/web",
    "qa:ids": "node scripts/qa-fixture.mjs",
    "qa:league:reset": "node scripts/qa-league-reset.mjs",
    "qa:auth:save": "node scripts/qa-auth-save.mjs",
    "qa:draft:run": "node scripts/qa-full-draft.mjs",
    "qa:draft:realtime": "node scripts/qa-draft-realtime.mjs",
    "qa:draft:watch": "node scripts/qa-draft-watch.mjs",
    "qa:draft:verify": "node scripts/qa-draft-verify-rosters.mjs",
    "qa:draft:autopick-fast": "node scripts/qa-draft-autopick-fast.mjs",
    "data:sportradar:historical": "node scripts/import-sportradar-historical-values.mjs",
    "db:apply": "node scripts/db-apply-migration.mjs",
    "qa:roster:needs": "node scripts/qa-roster-needs.mjs",
    "qa:transactions:run": "node scripts/qa-transactions-run.mjs",
    "qa:roster-integrity:audit": "node scripts/qa-roster-integrity-audit.mjs",
    "qa:roster-integrity:visual": "node scripts/qa-roster-integrity-visual.mjs",
    "qa:playwright": "playwright test --config=playwright.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "turbo": "^2.5.6",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
